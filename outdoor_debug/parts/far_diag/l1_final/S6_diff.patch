+def silog_far_weight_cfg(lc: dict) -> tuple[float, float] | None:
+    """L1 S6 opt-in: ``(far_weight, far_from)`` from ``loss.metric_silog_far_weight`` / ``loss.metric_silog_far_from``, or None when the feature is OFF (far_weight absent or exactly 1.0).
+    ``far_from`` is REQUIRED whenever the feature is on (no hidden default)."""
+    fw = lc.get("metric_silog_far_weight")
+    if fw is None or float(fw) == 1.0:
+        return None
+    ff = lc.get("metric_silog_far_from")
+    if ff is None:
+        raise ValueError("loss.metric_silog_far_weight != 1.0 needs loss.metric_silog_far_from (m)")
+    return float(fw), float(ff)
+
+
+def silog_far_weighted(diff_log: torch.Tensor, gt_depth: torch.Tensor, lambd: float, far_weight: float, far_from: float) -> torch.Tensor:
+    """L1 S6: SiLog with a per-pixel weight w = 1 + (far_weight - 1) * [gt_depth >= far_from] (GT metres, 1-D tensors over the SiLog-eligible pixels):
+    sqrt(sum(w d^2)/sum(w) - lambd * (sum(w d)/sum(w))^2), clamped at 1e-12 like the original. With all w equal this is algebraically the original expression."""
+    w = 1.0 + (far_weight - 1.0) * (gt_depth >= far_from).to(diff_log.dtype)
+    sw = w.sum()
+    m1 = (w * diff_log).sum() / sw
+    m2 = (w * diff_log.pow(2)).sum() / sw
+    return torch.sqrt((m2 - lambd * m1.pow(2)).clamp_min(1e-12))
+
