#!/bin/bash
# =============================================================================
# outdoor-debug screen DEV scoring, arm TS2: bench_joint.py on ONE GH200. DRAFT, NOT SUBMITTED. Generated by gen_train.sh.
# Pins (R3_PIN.md): bench_joint.py sha256 5d3d048ce7b26fb53e1e6a5aadf8265cb92c19dafc7340bc2e04cc6bcdf6e7ef;
#   DEV clip-list shas kitti e187a28b.. (7) nyuv2 49adc069.. (4) scannetpp 010a310b.. (31) vkitti 2f57ab48.. (10); combined aca96bbd894855cc99b8d97dbdf6e957d1c1f4efb0d49c77ff6108d8dccd7de6.
# Same host type (Isambard GH200) and same clone/commit for all 6 arms. Scores steps CKPT_STEP (default 14000) of the arm's own run dir.
# Submit AFTER the arm's training job finished OK:  sbatch --dependency=afterok:<train_jobid> outdoor_debug/parts/submit/SCORE_TS2.sbatch
# bench_joint is DEV only (--split dev, no --allow-test). Cells: b0s0 (clean), as in the D_baseline phase.
# =============================================================================
#SBATCH --job-name=outdoor_score_TS2
#SBATCH --partition=workq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --time=06:00:00
#SBATCH --mem=110G
#SBATCH --cpus-per-task=18
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -euo pipefail
export ARM="TS2"
export PROJECT_DIR="${PROJECT_DIR:-/projects/b5dh/RAMEN_outdoor_screen_2a72223}"
export CKPT_STEP="${CKPT_STEP:-14000}"
export OK_COMMITS="2a72223c068d5ba0bde869a7c27d0e90d21abb5d 0034ac711866d704a1cabe0b8ea38ed1d0b022ac"
export BJ_SHA="5d3d048ce7b26fb53e1e6a5aadf8265cb92c19dafc7340bc2e04cc6bcdf6e7ef"
export OUT_ROOT="${OUT_ROOT:-/projects/b5dh/RAMEN_outdoor_screen_2a72223_scores}"
export OUT="$OUT_ROOT/$ARM"
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-8} PYTHONFAULTHANDLER=1
export TMPDIR=/projects/b5dh/.torch_cache/tmp

cd "$PROJECT_DIR"
HEAD_SHA="$(git rev-parse HEAD)"; echo "commit $HEAD_SHA  job ${SLURM_JOB_ID:-local}  node $(hostname)  $(date -u +%FT%TZ)"
case " $OK_COMMITS " in *" $HEAD_SHA "*) ;; *) echo "ERROR: HEAD not allowed"; exit 1;; esac
[[ -z "$(git status --porcelain)" ]] || { echo "ERROR: dirty tree"; exit 1; }
[[ "$(sha256sum bench_joint.py | cut -d' ' -f1)" == "$BJ_SHA" ]] || { echo "ERROR: bench_joint.py sha mismatch"; exit 1; }
CK="$PROJECT_DIR/runs/outdoor_screen_${ARM}/step${CKPT_STEP}.pt"
[[ -f "$CK" ]] || { echo "ERROR: missing $CK"; exit 1; }
[[ ! -e "$OUT" ]] || { echo "ERROR: $OUT exists (never overwrite a score dir)"; exit 1; }
mkdir -p "$OUT"
echo "$HEAD_SHA" > "$OUT/HEAD.txt"; sha256sum "$CK" | tee "$OUT/checkpoint_sha256.txt"
source /projects/b5dh/FocusMamba/.venv/bin/activate

# DEV scoring: KITTI, NYUv2, ScanNet++ guards (+ TAE via --temporal) and the opt-in VKITTI set (far / by-range target); clean cell.
python bench_joint.py run --model "ours:$CK" --dataset kitti nyuv2 scannetpp vkitti --cells b0s0 --split dev --temporal \
    --out "$OUT/bench_joint_dev_b0s0_step${CKPT_STEP}.json"

# TODO(DDAD, exploratory DEV, report-only): the DDAD data is NOT on the cluster (ddad_val_frames.tsv b8d9664f.., LR_DEV/REGISTRATION.md). Add a
#   scoring step here only after the DDAD val frames + the scorer short_side (provisional 378) are fixed and copied to /projects/b5dh (Manager approval).
# TODO(by-range pooled metrics): VKITTI 80-655 m pred:gt and KITTI/VKITTI AbsRel by range come from the pooled-range scorer
#   outdoor_debug/parts/D_baseline/run_baseline.py, which is hard-coded to local paths and 4 models: needs a parametrised copy + Auditor check first.
sha256sum "$OUT"/*.json > "$OUT/SHA256SUMS"
echo "done $(date -u +%FT%TZ)"
