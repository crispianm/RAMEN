#!/bin/bash
# =============================================================================
# AV2 Stage 1 scoring of ONE checkpoint (@PAIR@ @ARM@) on ONE GH200 through run_score.py (RUNBOOK_STAGE1.md literals). DEV/held-out AV2 val (Stage 1 subset), registered rule; output is SEALED until the Auditor clears the read.
# Generated by sed from this template (@TAG@ @PAIR@ @ARM@ @CKPT@); UNSET_PIN_COMMIT is substituted outside the clone. The clone must be clean at the pin; every refusal stops the job (no workaround).
# =============================================================================
#SBATCH --job-name=av2s1_@TAG@
#SBATCH --partition=workq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --time=01:00:00
#SBATCH --mem=110G
#SBATCH --cpus-per-task=18
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err
set -euo pipefail
export PIN_COMMIT="UNSET_PIN_COMMIT"
export PROJECT_DIR="${PROJECT_DIR:-/projects/b5dh/RAMEN_av2score_UNSET}"
export CKPT="@CKPT@"
export DEST="/projects/b5dh/data/heldout/av2_val"
export OUTDIR="/projects/b5dh/RAMEN_av2_scores/stage1"
export VENV="/projects/b5dh/FocusMamba/.venv"
echo "======================================== av2s1_@TAG@  job ${SLURM_JOB_ID:-local} node $(hostname) $(date -u +%FT%TZ)"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader || true
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-8} PYTHONFAULTHANDLER=1
CACHE_ROOT="/projects/b5dh/.torch_cache"; mkdir -p "$CACHE_ROOT/tmp"; export TMPDIR="$CACHE_ROOT/tmp"
cd "$PROJECT_DIR" || { echo "ERROR: cannot cd $PROJECT_DIR"; exit 1; }
[[ "$PIN_COMMIT" =~ ^[0-9a-f]{40}$ ]] || { echo "ERROR: PIN_COMMIT not substituted"; exit 1; }
HEAD_SHA="$(git rev-parse HEAD)"; echo " Commit : $HEAD_SHA"
[[ "$HEAD_SHA" == "$PIN_COMMIT" ]] || { echo "ERROR: HEAD != PIN_COMMIT"; exit 1; }
[[ -z "$(git status --porcelain)" ]] || { echo "ERROR: dirty tree"; exit 1; }
A=outdoor_debug/parts/confirm/av2
[[ -f "$CKPT" ]] || { echo "ERROR: missing checkpoint $CKPT"; exit 1; }
for f in "$DEST/masks/sky_masks.npz" "$DEST/masks/sky_masks.meta.json" "$DEST/meta_R1/SHA256SUMS" "$DEST/meta_R1/av2_frames.tsv" "$DEST/meta_R1/av2_clips.tsv" "$DEST/meta_R1/objects.tsv"; do [[ -f "$f" ]] || { echo "ERROR: missing $f"; exit 1; }; done
OUT="$OUTDIR/@TAG@.json"
[[ ! -e "$OUT" ]] || { echo "ERROR: $OUT exists (never overwrite)"; exit 1; }
mkdir -p "$OUTDIR"
source "$VENV/bin/activate"
python -I "$A/run_score.py" "$A/RUNBOOK_STAGE1.md" -- @SCOREARGS@ --out "$OUT" --root "$DEST/data" --mask "$DEST/masks/sky_masks.npz" --frames "$DEST/meta_R1/av2_frames.tsv" --clips "$DEST/meta_R1/av2_clips.tsv" --objects "$DEST/meta_R1/objects.tsv" --logs "$A/av2_val_logs_stage1_50.txt" --sums "$DEST/meta_R1/SHA256SUMS" 2>&1 | tee "$OUTDIR/@TAG@.log"
[[ -s "$OUT" ]] || { echo "ERROR: no output json"; exit 1; }
sha256sum "$OUT" | tee "$OUT.sha256"
echo "======================================== done $(date -u +%FT%TZ) -> $OUT (SEALED until the Auditor clears the read)"
